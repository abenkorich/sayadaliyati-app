{
  "expo": {
    "name": "Saydaliyati",
    "slug": "saydaliyati",
    "version": "0.1.0",
    "scheme": "saydaliyati",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.saydaliyati.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-family-padded.png",
        "backgroundColor": "#087F7B"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Saydaliyati to attach a prescription image you select.",
          "cameraPermission": "Allow Saydaliyati to photograph a prescription.",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon-family-padded.png"
  }
}
