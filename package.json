{
  "name": "saydaliyati-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "bundle:android": "expo export --platform android --output-dir dist",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env.test test/api.integration.mjs",
    "android:install": "expo run:android --device",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build:android": "expo export --platform android --output-dir dist",
    "build:android:gradle": "export JAVA_HOME=/opt/homebrew/opt/openjdk@17 ANDROID_HOME=$HOME/Library/Android/sdk && cd /Volumes/Data/Workshop/Projects/saydaliyati-app/android && ./gradlew assembleRelease",
    "install:android": "$HOME/Library/Android/sdk/platform-tools/adb install -r /Volumes/Data/Workshop/Projects/saydaliyati-app/android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "57.0.25",
    "expo-constants": "57.0.19",
    "expo-image-manipulator": "57.0.20",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.23",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "24.13.6",
    "@types/react": "19.2.4",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.24.0"
  }
}
